{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/MeshFile",
  "$defs": {
    "MeshFile": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "meridian.mesh"
        },
        "version": {
          "type": "string",
          "pattern": "^v\\d+$",
          "description": "Mesh version; matches the artefact filename, e.g. \"v1\" for mesh.v1.json.gz"
        },
        "h3Resolution": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MeshCell"
          },
          "description": "Sorted by id ascending; array index is the cell index"
        },
        "columns": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/EncodedColumn"
          },
          "description": "Per-cell attribute columns, each of length cells.length"
        }
      },
      "required": [
        "format",
        "version",
        "h3Resolution",
        "cells",
        "columns"
      ],
      "additionalProperties": false,
      "title": "Meridian MeshFile"
    },
    "MeshCell": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{15}$",
          "description": "H3 cell index, lowercase hex"
        },
        "centroid": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "description": "[lon, lat] in WGS84, GeoJSON axis order"
        },
        "area": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Cell area in km²"
        },
        "province": {
          "type": "string",
          "enum": [
            "NL",
            "PE",
            "NS",
            "NB",
            "QC",
            "ON",
            "MB",
            "SK",
            "AB",
            "BC",
            "YT",
            "NT",
            "NU"
          ],
          "description": "Province/territory by largest area overlap"
        },
        "cd": {
          "type": "string",
          "pattern": "^\\d{4}$",
          "description": "StatCan census division CDUID"
        },
        "csd": {
          "type": "string",
          "pattern": "^\\d{7}$",
          "description": "StatCan census subdivision CSDUID"
        },
        "neighbours": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "description": "Indices into cells[] of adjacent cells in the mesh, ascending"
        }
      },
      "required": [
        "id",
        "centroid",
        "area",
        "province",
        "cd",
        "csd",
        "neighbours"
      ],
      "additionalProperties": false
    },
    "EncodedColumn": {
      "type": "object",
      "properties": {
        "dtype": {
          "type": "string",
          "enum": [
            "float32",
            "int32"
          ]
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Element count, not byte count"
        },
        "data": {
          "type": "string",
          "format": "base64",
          "contentEncoding": "base64",
          "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$",
          "description": "Base64 of little-endian element bytes"
        },
        "method": {
          "description": "How the values were produced, e.g. \"allocation_v1\" for estimated GDP",
          "type": "string"
        },
        "confidence": {
          "description": "0–1; present on any estimated column so the UI can label it",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "dtype",
        "length",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
