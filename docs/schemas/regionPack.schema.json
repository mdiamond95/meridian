{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/RegionPack",
  "$defs": {
    "RegionPack": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "meridian.regionPack"
        },
        "version": {
          "type": "number",
          "const": 1
        },
        "meta": {
          "$ref": "#/$defs/RegionPackMeta"
        },
        "assignment": {
          "description": "int32, length = mesh cell count; region id per cell, -1 = outside scope",
          "$ref": "#/$defs/IdColumn"
        },
        "regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Region"
          }
        },
        "setAnalysis": {
          "anyOf": [
            {
              "$ref": "#/$defs/SetAnalysis"
            },
            {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          ],
          "description": "The set analysis, or {} before Phase 4 filled it"
        },
        "children": {
          "description": "Nesting: packs splitting this pack's regions, each with meta.parentPack and meta.parentRegionId; a tree exports as its root",
          "type": "array",
          "items": {
            "$ref": "#/$defs/RegionPack"
          }
        }
      },
      "required": [
        "format",
        "version",
        "meta",
        "assignment",
        "regions",
        "setAnalysis"
      ],
      "additionalProperties": false,
      "title": "Meridian RegionPack v1"
    },
    "RegionPackMeta": {
      "type": "object",
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295,
          "description": "uint32 seed for mulberry32"
        },
        "method": {
          "type": "string",
          "enum": [
            "lens",
            "balanced",
            "seeded",
            "random",
            "template"
          ]
        },
        "params": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {},
          "description": "Solver parameters; shape owned by the engine"
        },
        "meshVersion": {
          "type": "string",
          "pattern": "^v\\d+$"
        },
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/IsoDate"
            },
            {
              "type": "null"
            }
          ],
          "description": "Atlas date the split was made against; null = present day"
        },
        "byteOrder": {
          "type": "string",
          "const": "le",
          "description": "Byte order of every encoded column in the pack"
        },
        "edited": {
          "description": "True once cells were painted by hand; the pack can no longer be regenerated from seed + params",
          "type": "boolean"
        },
        "edits": {
          "description": "Manual edits in the order they were made",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cell": {
                "$ref": "#/$defs/H3CellId"
              },
              "from": {
                "type": "integer",
                "minimum": -1,
                "maximum": 9007199254740991
              },
              "to": {
                "type": "integer",
                "minimum": -1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "cell",
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        },
        "id": {
          "description": "The pack's id: a preset's slug, or a hash of the recipe and assignment",
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "parentPack": {
          "description": "Nesting: the id of the pack whose region this pack splits (scope.kind 'region')",
          "type": "string"
        },
        "parentRegionId": {
          "description": "Nesting: that region's id in the parent pack",
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scenario": {
          "description": "The atlas scenario the split was made in, whole, so atlas scopes resolve the same way anywhere",
          "$ref": "#/$defs/Scenario"
        }
      },
      "required": [
        "seed",
        "method",
        "params",
        "meshVersion",
        "scope",
        "date",
        "byteOrder"
      ],
      "additionalProperties": false
    },
    "Scope": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "canada"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "province"
            },
            "province": {
              "type": "string",
              "enum": [
                "NL",
                "PE",
                "NS",
                "NB",
                "QC",
                "ON",
                "MB",
                "SK",
                "AB",
                "BC",
                "YT",
                "NT",
                "NU"
              ]
            }
          },
          "required": [
            "kind",
            "province"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "atlasUnit"
            },
            "unit": {
              "type": "string",
              "description": "AtlasUnit id, resolved at meta.date"
            }
          },
          "required": [
            "kind",
            "unit"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "atlasSovereign"
            },
            "sovereign": {
              "type": "string",
              "minLength": 1,
              "description": "Every de jure atlas unit under this sovereign at meta.date, e.g. \"Canada\" in 1867"
            }
          },
          "required": [
            "kind",
            "sovereign"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "region"
            },
            "pack": {
              "type": "string",
              "description": "Source pack URL or library id"
            },
            "region": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "pack",
            "region"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "polygon"
            },
            "geometry": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "Polygon",
                    "MultiPolygon"
                  ]
                },
                "coordinates": {
                  "type": "array",
                  "items": {}
                }
              },
              "required": [
                "type",
                "coordinates"
              ],
              "additionalProperties": false,
              "description": "GeoJSON geometry in WGS84"
            }
          },
          "required": [
            "kind",
            "geometry"
          ],
          "additionalProperties": false
        }
      ]
    },
    "IsoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "H3CellId": {
      "type": "string",
      "pattern": "^8[0-9a-f]{14}$",
      "description": "H3 cell index as lowercase hex (mode 1, so it starts with 8); never a number"
    },
    "Scenario": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "meridian.scenario"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "fork": {
          "description": "Where the scenario leaves the base atlas; its first event is on or after it",
          "$ref": "#/$defs/IsoDate"
        },
        "premise": {
          "type": "string",
          "minLength": 1,
          "description": "One paragraph"
        },
        "events": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioEvent"
          },
          "description": "Sorted by date ascending"
        }
      },
      "required": [
        "format",
        "id",
        "name",
        "fork",
        "premise",
        "events"
      ],
      "additionalProperties": false,
      "title": "Meridian Scenario"
    },
    "ScenarioEvent": {
      "type": "object",
      "properties": {
        "date": {
          "$ref": "#/$defs/IsoDate"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Citations, as for base events"
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AtlasRequirement"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ScenarioChange"
          }
        }
      },
      "required": [
        "date",
        "title",
        "note",
        "sources",
        "changes"
      ],
      "additionalProperties": false
    },
    "AtlasRequirement": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Stable snake_case id, e.g. \"ruperts_land\""
        },
        "exists": {
          "description": "Default true: the unit exists",
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "colony",
            "dominion",
            "province",
            "territory",
            "district",
            "hbc_charter",
            "unorganized",
            "foreign",
            "disputed"
          ]
        },
        "sovereign": {
          "type": "string",
          "minLength": 1
        },
        "because": {
          "type": "string",
          "minLength": 1,
          "description": "Why the event depends on it, with the instrument"
        }
      },
      "required": [
        "unit",
        "because"
      ],
      "additionalProperties": false
    },
    "ScenarioChange": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "create": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "colony",
                "dominion",
                "province",
                "territory",
                "district",
                "hbc_charter",
                "unorganized",
                "foreign",
                "disputed"
              ]
            },
            "sovereign": {
              "type": "string",
              "minLength": 1
            },
            "capital": {
              "type": [
                "string",
                "null"
              ]
            },
            "geometry": {
              "$ref": "#/$defs/__schema0"
            },
            "note": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "instrument": {
              "description": "What the counterfactual rests on: the proposal, bill or vote",
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          },
          "required": [
            "create"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "alter": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "status": {
              "type": "string",
              "enum": [
                "colony",
                "dominion",
                "province",
                "territory",
                "district",
                "hbc_charter",
                "unorganized",
                "foreign",
                "disputed"
              ]
            },
            "sovereign": {
              "type": "string",
              "minLength": 1
            },
            "capital": {
              "type": [
                "string",
                "null"
              ]
            },
            "geometry": {
              "$ref": "#/$defs/__schema0"
            },
            "note": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "instrument": {
              "description": "What the counterfactual rests on: the proposal, bill or vote",
              "type": "string"
            },
            "rationale": {
              "type": "string"
            }
          },
          "required": [
            "alter"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "rename": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "rename",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "dissolve": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "dissolve"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema0": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "unit": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$",
              "description": "A base atlas unit"
            },
            "at": {
              "description": "The date whose row of that unit is used",
              "$ref": "#/$defs/IsoDate"
            }
          },
          "required": [
            "unit",
            "at"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "union": {
              "minItems": 2,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema0"
              }
            }
          },
          "required": [
            "union"
          ],
          "additionalProperties": false
        }
      ]
    },
    "IdColumn": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "id"
        },
        "dtype": {
          "type": "string",
          "const": "int32"
        },
        "byteOrder": {
          "type": "string",
          "const": "le",
          "description": "Byte order of data; always little-endian"
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Element count, not byte count"
        },
        "data": {
          "type": "string",
          "format": "base64",
          "contentEncoding": "base64",
          "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$",
          "description": "Base64 of the element bytes in byteOrder"
        },
        "method": {
          "description": "How the values were produced, e.g. \"allocation_v1\" for estimated GDP",
          "type": "string"
        },
        "confidence": {
          "description": "0–1; present on any estimated column so the UI can label it",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "kind",
        "dtype",
        "byteOrder",
        "length",
        "data"
      ],
      "additionalProperties": false
    },
    "Region": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Value used for this region in assignment"
        },
        "name": {
          "type": "string"
        },
        "capital": {
          "type": [
            "string",
            "null"
          ]
        },
        "stats": {
          "type": "object",
          "properties": {
            "score": {
              "$ref": "#/$defs/RegionScore"
            }
          },
          "additionalProperties": {
            "type": "number"
          },
          "description": "Numbers by name, plus the game-facing `score` object"
        },
        "dossier": {
          "anyOf": [
            {
              "$ref": "#/$defs/RegionDossier"
            },
            {
              "type": "object",
              "properties": {},
              "additionalProperties": false
            }
          ],
          "description": "The region's dossier, or {} before Phase 4 filled it"
        }
      },
      "required": [
        "id",
        "name",
        "capital",
        "stats",
        "dossier"
      ],
      "additionalProperties": false
    },
    "RegionScore": {
      "type": "object",
      "properties": {
        "population": {
          "type": "number",
          "minimum": 0,
          "description": "People, 2021 census"
        },
        "gdp": {
          "type": "number",
          "minimum": 0,
          "description": "GDP allocated to the region, CAD millions (an allocation: see gdpCaveat)"
        },
        "resource_index": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of the labour force in agriculture, forestry, fishing, hunting, mining, quarrying, oil and gas"
        },
        "cohesion": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "1 − the population-weighted lens variance, scaled to 0–1"
        },
        "exposure": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "The dependency score: the largest industry's labour-force share"
        }
      },
      "required": [
        "population",
        "gdp",
        "resource_index",
        "cohesion",
        "exposure"
      ],
      "additionalProperties": false
    },
    "RegionDossier": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "nameSource": {
          "type": "string",
          "enum": [
            "generated",
            "manual"
          ]
        },
        "nameReason": {
          "type": "string",
          "minLength": 1
        },
        "capital": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "population": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "name",
                "population"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "mainCities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "population": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name",
              "population"
            ],
            "additionalProperties": false
          }
        },
        "secondaryCities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "population": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name",
              "population"
            ],
            "additionalProperties": false
          }
        },
        "population": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "areaKm2": {
          "type": "number",
          "minimum": 0
        },
        "densityPerKm2": {
          "type": "number",
          "minimum": 0
        },
        "gdpCadMillions": {
          "type": [
            "number",
            "null"
          ]
        },
        "gdpCaveat": {
          "type": "string",
          "const": "GDP is an estimate: provincial GDP by industry shared over cells by census labour force (allocation_v1), not a measurement of what a region produces."
        },
        "gdpPerCapita": {
          "type": [
            "number",
            "null"
          ]
        },
        "growth2016to2021": {
          "type": "number",
          "description": "Share, e.g. 0.052 for +5.2%"
        },
        "primaryIndustries": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "share": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "code",
              "label",
              "share"
            ],
            "additionalProperties": false
          }
        },
        "dependencyScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Share of the labour force in the top industry"
        },
        "urbanShare": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "People in a CMA or CA"
        },
        "internalColonyIndex": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "distanceToCapitalKmMean": {
          "type": "number",
          "minimum": 0
        },
        "languages": {
          "type": "object",
          "properties": {
            "english": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "french": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "indigenous": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "other": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "english",
            "french",
            "indigenous",
            "other"
          ],
          "additionalProperties": false
        },
        "indigenous": {
          "type": "object",
          "properties": {
            "identityShare": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "languageFamilies": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "share": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "label",
                  "share"
                ],
                "additionalProperties": false
              }
            },
            "majority": {
              "type": "boolean",
              "description": "Indigenous identity over half the population"
            }
          },
          "required": [
            "identityShare",
            "languageFamilies",
            "majority"
          ],
          "additionalProperties": false
        },
        "treatyComposition": {
          "type": "array",
          "items": {
