{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/IndigenousFile",
  "$defs": {
    "IndigenousFile": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "meridian.indigenous"
        },
        "version": {
          "type": "string",
          "pattern": "^v\\d+$"
        },
        "caveat": {
          "type": "string",
          "const": "Derived from modern language distribution and linguistic records; not pre-contact boundaries.",
          "description": "Shown with the layer; not optional in the UI"
        },
        "families": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/LanguageFamily"
          }
        },
        "areas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/FamilyArea"
          }
        },
        "communities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Community"
          },
          "description": "Sorted by id"
        },
        "attribution": {
          "minItems": 1,
          "type": "array",
          "items": {
            "$ref": "#/$defs/Attribution"
          }
        }
      },
      "required": [
        "format",
        "version",
        "caveat",
        "families",
        "areas",
        "communities",
        "attribution"
      ],
      "additionalProperties": false,
      "title": "Meridian IndigenousFile"
    },
    "LanguageFamily": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Value in the attrs column indigenous_language_family (0 = unassigned)"
        },
        "glottocode": {
          "type": "string",
          "pattern": "^[a-z0-9]{4}\\d{4}$",
          "description": "Top-level family or isolate in Glottolog"
        },
        "glottologName": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "Name shown on the map"
        }
      },
      "required": [
        "code",
        "glottocode",
        "glottologName",
        "label"
      ],
      "additionalProperties": false
    },
    "FamilyArea": {
      "type": "object",
      "properties": {
        "family": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "LanguageFamily.code"
        },
        "source": {
          "type": "string",
          "enum": [
            "census",
            "glottolog"
          ],
          "description": "census speakers, or the nearest Glottolog language"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cells": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Mesh cells in this area"
        },
        "geometryRef": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Key into indigenous.v1.topojson.gz"
        },
        "labelPoint": {
          "type": "array",
          "prefixItems": [
            {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2,
          "description": "[lng, lat] inside the largest part, for the family name on the map"
        }
      },
      "required": [
        "family",
        "source",
        "confidence",
        "cells",
        "geometryRef",
        "labelPoint"
      ],
      "additionalProperties": false
    },
    "Community": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "description": "Wikidata item number (Q-id without the Q)"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "English label on Wikidata"
        },
        "people": {
          "type": "string",
          "enum": [
            "first_nation",
            "inuit",
            "metis"
          ]
        },
        "lng": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      },
      "required": [
        "id",
        "name",
        "people",
        "lng",
        "lat"
      ],
      "additionalProperties": false
    },
    "Attribution": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Source id in docs/data-sources.md"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "licence": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "source",
        "text",
        "licence",
        "url"
      ],
      "additionalProperties": false
    }
  }
}
