{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/AttrsFile",
  "$defs": {
    "AttrsFile": {
      "type": "object",
      "properties": {
        "format": {
          "type": "string",
          "const": "meridian.attrs"
        },
        "version": {
          "type": "string",
          "pattern": "^v\\d+$"
        },
        "meshVersion": {
          "type": "string",
          "pattern": "^v\\d+$"
        },
        "cellCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "meta": {
          "$ref": "#/$defs/FileMeta"
        },
        "columns": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/ColumnName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/EncodedColumn"
          }
        },
        "lookups": {
          "description": "Labels for id columns: column name → code → label",
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/ColumnName"
          },
          "additionalProperties": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^-?\\d+$"
            },
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "sideTables": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/ColumnName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/SideTable"
          }
        }
      },
      "required": [
        "format",
        "version",
        "meshVersion",
        "cellCount",
        "meta",
        "columns"
      ],
      "additionalProperties": false,
      "title": "Meridian AttrsFile"
    },
    "FileMeta": {
      "type": "object",
      "properties": {
        "byteOrder": {
          "type": "string",
          "const": "le"
        }
      },
      "required": [
        "byteOrder"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "description": "byteOrder plus free-form provenance, e.g. gdp_method"
    },
    "ColumnName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
    },
    "EncodedColumn": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "count",
                "id"
              ],
              "description": "Counts and ids (including categorical codes) are int32"
            },
            "dtype": {
              "type": "string",
              "const": "int32"
            },
            "byteOrder": {
              "type": "string",
              "const": "le",
              "description": "Byte order of data; always little-endian"
            },
            "length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Element count, not byte count"
            },
            "data": {
              "type": "string",
              "format": "base64",
              "contentEncoding": "base64",
              "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$",
              "description": "Base64 of the element bytes in byteOrder"
            },
            "method": {
              "description": "How the values were produced, e.g. \"allocation_v1\" for estimated GDP",
              "type": "string"
            },
            "confidence": {
              "description": "0–1; present on any estimated column so the UI can label it",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "dtype",
            "byteOrder",
            "length",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "share",
                "rate",
                "index"
              ],
              "description": "Shares, rates and indices are float32"
            },
            "dtype": {
              "type": "string",
              "const": "float32"
            },
            "byteOrder": {
              "type": "string",
              "const": "le",
              "description": "Byte order of data; always little-endian"
            },
            "length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Element count, not byte count"
            },
            "data": {
              "type": "string",
              "format": "base64",
              "contentEncoding": "base64",
              "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$",
              "description": "Base64 of the element bytes in byteOrder"
            },
            "method": {
              "description": "How the values were produced, e.g. \"allocation_v1\" for estimated GDP",
              "type": "string"
            },
            "confidence": {
              "description": "0–1; present on any estimated column so the UI can label it",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "dtype",
            "byteOrder",
            "length",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "money",
              "description": "Money is float32 in millions of CAD"
            },
            "dtype": {
              "type": "string",
              "const": "float32"
            },
            "unit": {
              "type": "string",
              "const": "cad_millions"
            },
            "byteOrder": {
              "type": "string",
              "const": "le",
              "description": "Byte order of data; always little-endian"
            },
            "length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Element count, not byte count"
            },
            "data": {
              "type": "string",
              "format": "base64",
              "contentEncoding": "base64",
              "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$",
              "description": "Base64 of the element bytes in byteOrder"
            },
            "method": {
              "description": "How the values were produced, e.g. \"allocation_v1\" for estimated GDP",
              "type": "string"
            },
            "confidence": {
              "description": "0–1; present on any estimated column so the UI can label it",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "dtype",
            "unit",
            "byteOrder",
            "length",
            "data"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "measure",
              "description": "Physical measures are float32 with an explicit unit"
            },
            "dtype": {
              "type": "string",
              "const": "float32"
            },
            "unit": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            "byteOrder": {
              "type": "string",
              "const": "le",
              "description": "Byte order of data; always little-endian"
            },
            "length": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Element count, not byte count"
            },
            "data": {
              "type": "string",
              "format": "base64",
              "contentEncoding": "base64",
              "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$",
              "description": "Base64 of the element bytes in byteOrder"
            },
            "method": {
              "description": "How the values were produced, e.g. \"allocation_v1\" for estimated GDP",
              "type": "string"
            },
            "confidence": {
              "description": "0–1; present on any estimated column so the UI can label it",
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "dtype",
            "unit",
            "byteOrder",
            "length",
            "data"
          ],
          "additionalProperties": false
        }
      ]
    },
    "SideTable": {
      "type": "object",
      "properties": {
        "offsets": {
          "description": "int32, length cellCount + 1; values for cell i are values[offsets[i]:offsets[i+1]]",
          "$ref": "#/$defs/IdColumn"
        },
        "values": {
          "$ref": "#/$defs/IdColumn"
        }
      },
      "required": [
        "offsets",
        "values"
      ],
      "additionalProperties": false,
      "description": "Variable-length per-cell id lists in CSR form, e.g. Wikidata ids of the Indigenous communities in each cell"
    },
    "IdColumn": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "id"
        },
        "dtype": {
          "type": "string",
          "const": "int32"
        },
        "byteOrder": {
          "type": "string",
          "const": "le",
          "description": "Byte order of data; always little-endian"
        },
        "length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "description": "Element count, not byte count"
        },
        "data": {
          "type": "string",
          "format": "base64",
          "contentEncoding": "base64",
          "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$",
          "description": "Base64 of the element bytes in byteOrder"
        },
        "method": {
          "description": "How the values were produced, e.g. \"allocation_v1\" for estimated GDP",
          "type": "string"
        },
        "confidence": {
          "description": "0–1; present on any estimated column so the UI can label it",
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "kind",
        "dtype",
        "byteOrder",
        "length",
        "data"
      ],
      "additionalProperties": false
    }
  }
}
