{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/Topology",
  "$defs": {
    "Topology": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "Topology"
        },
        "objects": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/TopoGeometry"
          }
        },
        "arcs": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "minItems": 2,
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "number"
              }
            }
          }
        },
        "transform": {
          "type": "object",
          "properties": {
            "scale": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "translate": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "scale",
            "translate"
          ],
          "additionalProperties": false
        },
        "bbox": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "type",
        "objects",
        "arcs"
      ],
      "additionalProperties": {},
      "title": "TopoJSON Topology"
    },
    "TopoGeometry": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "Point",
            "MultiPoint",
            "LineString",
            "MultiLineString",
            "Polygon",
            "MultiPolygon",
            "GeometryCollection"
          ]
        },
        "id": {
          "type": [
            "string",
            "number"
          ]
        },
        "properties": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "arcs": {
          "type": "array",
          "items": {}
        },
        "coordinates": {
          "type": "array",
          "items": {}
        },
        "geometries": {
          "type": "array",
          "items": {}
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": {}
    }
  }
}
