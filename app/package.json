{
  "name": "@meridian/app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "smoke": "playwright test",
    "schemas": "tsx scripts/export-schemas.ts",
    "schemas:check": "tsx scripts/export-schemas.ts --check",
    "frame-time": "playwright test --config playwright.perf.config.ts",
    "determinism": "playwright test --config playwright.determinism.config.ts",
    "presets": "tsx scripts/make-presets.ts",
    "rules": "tsx scripts/build-rules.ts",
    "rules:check": "tsx scripts/build-rules.ts --check",
    "scenarios": "tsx scripts/build-scenarios.ts",
    "scenarios:check": "tsx scripts/build-scenarios.ts --check"
  },
  "dependencies": {
    "@tmcw/togeojson": "^7.1.2",
    "leaflet": "^1.9.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "2.8.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mapbox/geojsonhint": "^3.3.0",
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.13.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@xmldom/xmldom": "^0.9.12",
    "esbuild": "0.28.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "topojson-client": "^3.1.0",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "xmllint-wasm": "^5.3.0"
  }
}
